APP_NAME=NovaShop API
APP_VERSION=0.1.0
ENVIRONMENT=development

FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379

POSTGRES_DB=novashop
POSTGRES_USER=novashop
POSTGRES_PASSWORD=change-me

# Server-side only, and deliberately not NEXT_PUBLIC_*. Next.js inlines
# NEXT_PUBLIC_* into the client bundle at build time, so a runtime container
# variable of that name has no effect on browser code -- which is why the
# frontend fetches on the server and the browser never learns this address.
BACKEND_URL=http://backend:8000
