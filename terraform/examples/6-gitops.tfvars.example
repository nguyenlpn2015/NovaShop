# Layer 6 — GitOps bootstrap.
#
#   export TF_VAR_ssh_private_key="$(cat ~/.ssh/novashop)"
#
# plan needs a reachable cluster: this layer reads the live root Application to validate the
# handover it performs.

kubeconfig_path    = "/etc/rancher/k3s/k3s.yaml"
kubeconfig_context = ""

node_host       = "10.10.1.45"
node_user       = "smartdev"
repository_root = "/opt/novashop/NovaShop"

# Version and digest must move together. The digest is what makes substitution of a large
# remote manifest applied with cluster-admin detectable; a version tag is a mutable pointer.
argocd_version         = "v3.4.4"
argocd_manifest_sha256 = "b0f9119821f2e19b852c842b9cb235eb9c3ef1549554fbda6aa5904e8d440eae"
argocd_namespace       = "argocd"

# The handover point. main, not a commit SHA — pinning the root Application would mean no
# GitOps change could ever take effect without editing the cluster.
root_application_name  = "novashop-root"
gitops_repo_url        = "https://github.com/nguyenlpn2015/NovaShop-GitOps.git"
gitops_target_revision = "main"
gitops_path            = "clusters/ubuntu-k3s"
project_name           = "novashop"

manage_repository_registration = true

# false on an already-bootstrapped cluster. The scripts wait for Deployments and rollouts —
# a long no-op that surprises whoever expected a quick apply. Set true on a fresh node or
# during recovery, which is where this layer earns its place.
run_bootstrap = false
